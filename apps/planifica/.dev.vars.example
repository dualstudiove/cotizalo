# Copia este archivo como .dev.vars (solo desarrollo local con `wrangler dev`; no se sube a Git).
# ENVIRONMENT=development: cookies sin «Secure» (http://localhost) y, si falta SESSION_SECRET, uno de desarrollo.
ENVIRONMENT=development
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas-caracteres
# Para tener un administrador en local (se crea solo al arrancar):
# SUPER_EMAIL=admin@dualstudio.test
# SUPER_PASSWORD=Admin12345
# Métricas de Instagram (opcional): clave para cifrar los tokens; si falta, se usa SESSION_SECRET.
# TOKENS_KEY=otro-texto-largo-y-aleatorio
# Para probar sin Instagram real, una API simulada:
# IG_API_BASE=http://localhost:9911
# «Conectar con Meta» (inicio de sesión unificado): la clave secreta de la app de Meta.
# META_APP_SECRET=...
# Para probar sin Meta real: API y diálogo simulados, y la dirección de vuelta local.
# META_API_BASE=http://localhost:9911
# META_DIALOG_BASE=http://localhost:9911
# META_VUELTA=http://localhost:8787/planifica/redes/meta/vuelta
